# .env

# Nhost Configuration
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=
# REQUIS pour l'admin (/admin/products) et le webhook abonnement
NHOST_ADMIN_SECRET=

# Flutterwave Configuration
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Cron job (Vercel) - secret pour sécuriser l'endpoint /api/cron/expire-subscriptions
CRON_SECRET=

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Optional: Stripe shipping rate IDs (create these in your Stripe Dashboard)
STRIPE_SHIPPING_RATE_1=
STRIPE_SHIPPING_RATE_2=